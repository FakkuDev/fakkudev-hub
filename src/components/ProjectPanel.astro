---
import { getCollection } from "astro:content";
import * as simpleIconsRaw from "simple-icons";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

// Miniaturas importadas en build-time
const allImages = import.meta.glob("../assets/thumbs/*.webp", {
    eager: true,
}) as Record<string, unknown>;
const imageMap = new Map<string, any>();
for (const [path, mod] of Object.entries(allImages)) {
    const filename = path.split("/").pop()?.replace(".webp", "");
    const meta = ((mod as any)?.default ?? mod) as any;
    if (filename && meta?.src) imageMap.set(filename, meta);
}

const projectThumbnails = sortedProjects.map((p) => ({
    slug: p.data.slug,
    src: imageMap.get(p.data.slug)?.src ?? "",
}));

// Nombre amigable -> slug oficial de simple-icons
const TECH_SLUGS: Record<string, string | null> = {
    astro: "astro",
    tailwind: "tailwindcss",
    tailwindcss: "tailwindcss",
    "alpine.js": "alpinedotjs",
    alpinejs: "alpinedotjs",
    "cloudflare pages": "cloudflarepages",
    cloudflare: "cloudflare",
    javascript: "javascript",
    js: "javascript",
    html: "html5",
    html5: "html5",
    css: "css3",
    css3: "css3",
    python: "python",
    "c#": "csharp",
    csharp: "csharp",
    canva: "canva",
    react: "react",
    vue: "vuedotjs",
    "vue.js": "vuedotjs",
    angular: "angular",
    svelte: "svelte",
    "next.js": "nextdotjs",
    nuxt: "nuxtdotjs",
    node: "nodedotjs",
    "node.js": "nodedotjs",
    typescript: "typescript",
    sass: "sass",
    bootstrap: "bootstrap",
    figma: "figma",
    wordpress: "wordpress",
    php: "php",
    laravel: "laravel",
    docker: "docker",
    firebase: "firebase",
    mongodb: "mongodb",
    postgresql: "postgresql",
    mysql: "mysql",
    redis: "redis",
    git: "git",
    github: "github",
    vercel: "vercel",
    netlify: "netlify",
    vite: "vite",
    graphql: "graphql",
    supabase: "supabase",
    jquery: "jquery",
    seo: null,
};

const simpleIcons = simpleIconsRaw as unknown as Record<
    string,
    { slug?: string; path?: string }
>;
const iconBySlug = new Map<string, string>();
for (const key of Object.keys(simpleIcons)) {
    const icon = simpleIcons[key];
    if (
        icon &&
        typeof icon === "object" &&
        typeof icon.slug === "string" &&
        typeof icon.path === "string"
    ) {
        iconBySlug.set(icon.slug, icon.path);
    }
}

const techNames = new Set<string>();
for (const p of sortedProjects) for (const s of p.data.stack) techNames.add(s);

const techIcons: Record<string, string | null> = {};
for (const name of techNames) {
    const lower = name.toLowerCase();
    const mapped =
        lower in TECH_SLUGS
            ? TECH_SLUGS[lower]
            : lower.replace(/[^a-z0-9]/g, "");
    techIcons[name] = mapped ? (iconBySlug.get(mapped) ?? null) : null;
}
---

<dialog
    id="project-panel"
    class="panel-dialog"
    aria-labelledby="panel-title"
    aria-modal="true"
>
    <div class="panel-backdrop" data-close></div>
    <div class="panel-content">
        <header class="panel-header">
            <div class="header-info">
                <span class="panel-category" id="panel-category">
                    Categoría
                </span>
                <h2 id="panel-title" class="panel-title">
                    Título del Proyecto
                </h2>
            </div>
            <div class="panel-actions">
                <a
                    id="panel-live-link"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-icon"
                    aria-label="Abrir sitio en vivo"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                </a>
                <button
                    id="panel-close"
                    class="btn-icon"
                    aria-label="Cerrar panel"
                    data-close
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
        </header>

        <div class="panel-image-section">
            <div class="panel-image-wrapper">
                <img id="panel-image" src="" alt="" class="panel-image" />
            </div>
        </div>

        <nav class="panel-tabs" aria-label="Secciones del proyecto">
            <button class="tab-btn active" data-tab="resumen">
                Resumen
            </button>
            <button class="tab-btn" data-tab="funciones">
                Funciones
            </button>
            <button class="tab-btn" data-tab="stack">
                Stack
            </button>
            <button class="tab-btn" data-tab="resultados">
                Resultados
            </button>
            <div class="tab-indicator"></div>
        </nav>

        <div class="panel-body">
            <div id="tab-resumen" class="tab-content active">
                <div id="panel-summary" class="summary-text"></div>
            </div>
            <div id="tab-funciones" class="tab-content">
                <ul id="panel-features" class="feature-list"></ul>
            </div>
            <div id="tab-stack" class="tab-content">
                <div id="panel-stack" class="stack-list"></div>
                <p class="hosting-info">
                    Hosteado en: <strong id="panel-hosting"></strong>
                </p>
            </div>
            <div id="tab-resultados" class="tab-content">
                <div class="metrics-grid">
                    <div class="metric-card">
                        <span class="metric-label">Performance</span>
                        <span class="metric-value" id="metric-perf">
                            0
                        </span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">SEO</span>
                        <span class="metric-value" id="metric-seo">
                            0
                        </span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">Accesibilidad</span>
                        <span class="metric-value" id="metric-a11y">
                            0
                        </span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">Carga</span>
                        <span class="metric-value" id="metric-load">
                            0s
                        </span>
                    </div>
                </div>
                <div class="status-badge" id="panel-status"></div>
            </div>
        </div>

        <footer class="panel-footer">
            <a
                id="footer-live"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
            >
                Ver en vivo
            </a>
            <a
                id="footer-repo"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary"
            >
                Ver código
            </a>
        </footer>
    </div>
</dialog>

<style>
    .panel-dialog {
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--color-text-primary);
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        max-width: none;
        max-height: none;
        overflow: hidden;
    }
    .panel-dialog::backdrop {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        opacity: 0;
        transition: opacity var(--duration-base) var(--ease-out-expo);
    }
    .panel-dialog[open]::backdrop {
        opacity: 1;
    }
    .panel-backdrop {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .panel-content {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 100%;
        max-width: 520px;
        height: 100%;
        background: #0a0a0a;
        border-left: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform var(--duration-base) var(--ease-out-expo);
        overflow: hidden;
        z-index: 1;
    }
    .panel-dialog[open] .panel-content {
        transform: translateX(0);
    }
    @media (max-width: 640px) {
        .panel-content {
            max-width: 100%;
            border-left: none;
        }
    }

    .panel-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-shrink: 0;
    }
    .header-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        flex: 1;
    }
    .panel-category {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-secondary);
    }
    .panel-title {
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--color-text-primary);
        margin: 0;
    }
    .panel-actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }
    .btn-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text-primary);
        cursor: pointer;
        transition: all var(--duration-fast) ease;
        text-decoration: none;
    }
    .btn-icon:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--color-border-hover);
    }

    .panel-image-section {
        padding: 20px 24px;
        background: #0a0a0a;
        border-bottom: 1px solid var(--color-border);
        flex-shrink: 0;
    }
    .panel-image-wrapper {
        width: 100%;
        aspect-ratio: 2 / 1;
        background: #050505;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .panel-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .panel-tabs {
        display: flex;
        border-bottom: 1px solid var(--color-border);
        position: relative;
        padding: 0 24px;
        flex-shrink: 0;
        overflow-x: auto;
    }
    .tab-btn {
        background: none;
        border: none;
        color: var(--color-text-secondary);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 500;
        padding: 14px 18px;
        cursor: pointer;
        transition: color var(--duration-fast) ease;
        white-space: nowrap;
    }
    .tab-btn:hover {
        color: var(--color-text-primary);
    }
    .tab-btn.active {
        color: var(--color-accent);
    }
    .tab-indicator {
        position: absolute;
        bottom: -1px;
        left: 0;
        height: 2px;
        width: 0;
        background: var(--color-accent);
        transition: all var(--duration-fast) var(--ease-out-expo);
    }

    .panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        min-height: 0;
    }
    .panel-body::-webkit-scrollbar {
        width: 6px;
    }
    .panel-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .panel-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
    }

    .tab-content {
        display: none;
        animation: fadeIn 300ms ease;
    }
    .tab-content.active {
        display: block;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hosting-info {
        color: var(--color-text-secondary);
        font-size: 0.82rem;
        margin: 0;
    }
    .hosting-info strong {
        color: var(--color-text-primary);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }
    .metric-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .metric-label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-secondary);
    }
    .metric-value {
        font-size: 1.45rem;
        font-weight: 600;
        color: var(--color-accent);
        letter-spacing: -0.02em;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 500;
    }
    .status-badge.online {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .status-badge.desarrollo {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .panel-footer {
        padding: 18px 24px;
        border-top: 1px solid var(--color-border);
        display: flex;
        gap: 12px;
        background: #0a0a0a;
        flex-shrink: 0;
    }
    .btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        transition: all var(--duration-fast) ease;
    }
    .btn-primary {
        background: var(--color-text-primary);
        color: var(--color-bg);
    }
    .btn-primary:hover {
        background: #e4e4e7;
    }
    .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--color-text-primary);
        border: 1px solid var(--color-border);
    }
    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
    }
    .btn.hidden {
        display: none;
    }
</style>

<style is:global>
    /* El CSS scoped NO alcanza al HTML inyectado con innerHTML.
       Estas reglas quedan fuera del scope, ancladas al id del dialog. */
    #project-panel .summary-text p {
        color: var(--color-text-secondary);
        line-height: 1.65;
        margin: 0 0 18px 0;
        font-size: 0.92rem;
    }
    #project-panel .summary-text p:last-child {
        margin-bottom: 0;
    }

    #project-panel .feature-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 0;
        margin: 0;
    }
    #project-panel .feature-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: var(--color-text-secondary);
        font-size: 0.88rem;
        line-height: 1.5;
    }
    #project-panel .feature-list li svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        margin-top: 2px;
        color: var(--color-accent);
    }

    #project-panel .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }
    #project-panel .stack-list .mini-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--color-text-secondary);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px 12px;
        border-radius: 999px;
        transition: all 300ms ease;
    }
    #project-panel .stack-list .mini-chip:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.12);
        color: var(--color-text-primary);
    }
    #project-panel .stack-list .mini-chip svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        display: block;
    }
</style>

<script
    is:inline
    define:vars={{
        projects: sortedProjects,
        thumbnails: projectThumbnails,
        techIcons,
    }}
>
    const dialog = document.getElementById("project-panel");
    const allProjects = projects;
    const thumbnailMap = new Map(thumbnails.map((t) => [t.slug, t.src]));
    let currentProjectIndex = -1;
    let triggerElement = null;

    const GENERIC_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;display:block"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`;

    const techIconSvg = (name) => {
        const d = techIcons[name] ?? null;
        return d
            ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0;display:block"><path d="${d}"/></svg>`
            : GENERIC_ICON;
    };

    const updateIndicator = (btn) => {
        const indicator = document.querySelector(".tab-indicator");
        if (!indicator) return;
        indicator.style.width = `${btn.offsetWidth}px`;
        indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
    };

    const openPanel = (slug, trigger) => {
        const project = allProjects.find((p) => p.data.slug === slug);
        if (!project) return;

        currentProjectIndex = allProjects.findIndex(
            (p) => p.data.slug === slug,
        );
        triggerElement = trigger;

        document.getElementById("panel-category").textContent =
            project.data.category;
        document.getElementById("panel-title").textContent = project.data.title;
        document.getElementById("panel-live-link").href = project.data.url;

        const imgEl = document.getElementById("panel-image");
        imgEl.src = thumbnailMap.get(slug) || "";
        imgEl.alt = project.data.title;

        document.getElementById("panel-summary").innerHTML =
            project.data.summary.map((p) => `<p>${p}</p>`).join("");

        document.getElementById("panel-features").innerHTML =
            project.data.features
                .map(
                    (f) =>
                        `<li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg><span>${f}</span></li>`,
                )
                .join("");

        document.getElementById("panel-stack").innerHTML = project.data.stack
            .map(
                (s) =>
                    `<span class="mini-chip">${techIconSvg(s)}<span>${s}</span></span>`,
            )
            .join("");
        document.getElementById("panel-hosting").textContent =
            project.data.hosting;

        document.getElementById("metric-perf").textContent =
            project.data.metrics.performance;
        document.getElementById("metric-seo").textContent =
            project.data.metrics.seo;
        document.getElementById("metric-a11y").textContent =
            project.data.metrics.accessibility;
        document.getElementById("metric-load").textContent =
            project.data.metrics.loadTime;

        const statusEl = document.getElementById("panel-status");
        statusEl.textContent =
            project.data.status === "online" ? "● Online" : "◐ En desarrollo";
        statusEl.className = `status-badge ${project.data.status === "online" ? "online" : "desarrollo"}`;

        document.getElementById("footer-live").href = project.data.url;
        const repoBtn = document.getElementById("footer-repo");
        if (project.data.repo) {
            repoBtn.href = project.data.repo;
            repoBtn.classList.remove("hidden");
        } else {
            repoBtn.classList.add("hidden");
        }

        document
            .querySelectorAll(".tab-btn")
            .forEach((btn, i) => btn.classList.toggle("active", i === 0));
        document
            .querySelectorAll(".tab-content")
            .forEach((content, i) =>
                content.classList.toggle("active", i === 0),
            );

        requestAnimationFrame(() => {
            const firstTab = document.querySelector(".tab-btn");
            if (firstTab) updateIndicator(firstTab);
        });

        dialog.showModal();
        document.body.style.overflow = "hidden";
        window.history.replaceState(null, "", `#${slug}`);
    };

    const closePanel = () => {
        dialog.close();
        document.body.style.overflow = "";
        window.history.replaceState(null, "", window.location.pathname);
        if (triggerElement) {
            triggerElement.focus();
            triggerElement = null;
        }
    };

    document.querySelectorAll(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
            const slug = card.getAttribute("data-slug");
            if (slug) openPanel(slug, card);
        });
    });

    document
        .querySelectorAll("[data-close]")
        .forEach((el) => el.addEventListener("click", closePanel));
    dialog.addEventListener("click", (e) => {
        if (e.target === dialog) closePanel();
    });

    document.addEventListener("keydown", (e) => {
        if (!dialog.open) return;
        if (e.key === "Escape") closePanel();
        if (
            e.key === "ArrowRight" &&
            currentProjectIndex < allProjects.length - 1
        ) {
            const next = allProjects[currentProjectIndex + 1];
            openPanel(
                next.data.slug,
                document.querySelector(`[data-slug="${next.data.slug}"]`),
            );
        }
        if (e.key === "ArrowLeft" && currentProjectIndex > 0) {
            const prev = allProjects[currentProjectIndex - 1];
            openPanel(
                prev.data.slug,
                document.querySelector(`[data-slug="${prev.data.slug}"]`),
            );
        }
    });

    document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const target = e.currentTarget.getAttribute("data-tab");
            document
                .querySelectorAll(".tab-btn")
                .forEach((b) => b.classList.remove("active"));
            document
                .querySelectorAll(".tab-content")
                .forEach((c) => c.classList.remove("active"));
            e.currentTarget.classList.add("active");
            document.getElementById(`tab-${target}`)?.classList.add("active");
            updateIndicator(e.currentTarget);
        });
    });

    if (window.location.hash) {
        const slug = window.location.hash.replace("#", "");
        const card = document.querySelector(`[data-slug="${slug}"]`);
        if (card) setTimeout(() => openPanel(slug, card), 300);
    }
</script>
