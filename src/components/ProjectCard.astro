---
const { project, index, image } = Astro.props as {
    project: any;
    index: number;
    image?: any;
};

const title = project?.data?.title ?? "Proyecto";
const slug = project?.data?.slug ?? "";
const category = project?.data?.category ?? "";
const stack: string[] = project?.data?.stack ?? [];
const imageSrc: string = image?.src ?? "";
---

<button
    class="project-card"
    data-slug={slug}
    aria-label={`Ver detalles de ${title}`}
    style={`animation-delay: ${index * 100}ms`}
>
    <div class="image-wrapper">
        {imageSrc ? (
            <img
                src={imageSrc}
                alt={`Captura de ${title}`}
                width={1600}
                height={1000}
                loading="lazy"
                class="card-image"
            />
        ) : (
            <div class="image-placeholder">
                <svg
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                    <circle cx="9" cy="9" r="2" />
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                </svg>
            </div>
        )}
        <div class="hover-overlay">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
            </svg>
        </div>
    </div>

    <div class="card-footer">
        <div class="footer-info">
            <span class="category">{category}</span>
            <h3 class="title">{title}</h3>
        </div>
        <div class="stack-mini">
            {stack.slice(0, 2).map((s) => (
                <span class="mini-chip">{s}</span>
            ))}
        </div>
    </div>
</button>

<style>
    .project-card {
        position: relative;
        width: 100%;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-box);
        overflow: hidden;
        cursor: pointer;
        text-align: left;
        transition:
            transform var(--duration-base) var(--ease-out-expo),
            border-color var(--duration-fast) ease,
            box-shadow var(--duration-base) var(--ease-out-expo);
        opacity: 0;
        animation: fadeInUp 600ms var(--ease-out-expo) forwards;
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .project-card:hover,
    .project-card:focus-visible {
        transform: translateY(-4px);
        border-color: var(--color-border-hover);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    .image-wrapper {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #0a0a0a;
    }
    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease-out-expo);
    }
    .project-card:hover .card-image {
        transform: scale(1.03);
    }
    .image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-secondary);
        background: #0a0a0a;
    }
    .hover-overlay {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        width: 36px;
        height: 36px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-primary);
        opacity: 0;
        transform: translateY(4px);
        transition: all var(--duration-fast) var(--ease-out-expo);
    }
    .project-card:hover .hover-overlay {
        opacity: 1;
        transform: translateY(0);
    }
    .card-footer {
        padding: var(--space-4);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: var(--space-4);
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid rgba(255, 255, 255, 0.04);
    }
    .category {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        letter-spacing: 0.05em;
    }
    .title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-text-primary);
        margin-top: var(--space-1);
        letter-spacing: -0.01em;
    }
    .stack-mini {
        display: flex;
        gap: var(--space-2);
    }
    .mini-chip {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-text-secondary);
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 8px;
        border-radius: var(--radius-chip);
    }
</style>
