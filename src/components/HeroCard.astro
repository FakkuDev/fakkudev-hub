---
import { profile } from "../data/profile";
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";

const whatsappMsg = encodeURIComponent(
    "Hola Facundo, me interesa un proyecto.",
);
const whatsappLink = `https://wa.me/542634346236?text=${whatsappMsg}`;
---

<section class="hero-wrapper" aria-labelledby="hero-title">
    <article class="hero-card" id="hero-card">
        <div class="spotlight"></div>
        <div class="noise-overlay"></div>
        <div class="gradient-border"></div>

        <div class="card-content">
            <header class="card-header">
                <div class="avatar">
                    <Image
                        src={logo}
                        alt="Logo de FakkuDev"
                        width={56}
                        height={56}
                        class="avatar-img"
                    />
                </div>
                <div class="header-text">
                    <h1 id="hero-title" class="name">
                        {profile.name}
                    </h1>
                    <span class="alias">@{profile.alias}</span>
                </div>
            </header>

            <div class="status-pill">
                <span class="pulsing-dot"></span>
                <span>{profile.status}</span>
            </div>

            <ul class="roles">
                {profile.roles.map((role) => (
                    <li>{role}</li>
                ))}
            </ul>

            <div class="location">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                <span>{profile.location}</span>
            </div>

            <div class="stack-chips">
                {profile.stack.map((skill) => (
                    <span class="chip">{skill}</span>
                ))}
            </div>

            <div class="actions">
                <a
                    href={whatsappLink}
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    Contactar por WhatsApp
                </a>
                <a
                    href={profile.contact.github}
                    class="btn btn-secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                    GitHub
                </a>
            </div>

            <div class="socials">
                <a
                    href={profile.contact.linkedin}
                    aria-label="LinkedIn"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                        <rect width="4" height="12" x="2" y="9" />
                        <circle cx="4" cy="4" r="2" />
                    </svg>
                </a>
                <a
                    href={profile.contact.facebook}
                    aria-label="Facebook"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                    </svg>
                </a>
            </div>
        </div>
    </article>
</section>

<style>
    .hero-wrapper {
        display: flex;
        justify-content: center;
        padding: var(--space-8) var(--space-4);
        perspective: 1000px;
    }
    .hero-card {
        position: relative;
        width: 100%;
        max-width: 720px;
        border-radius: var(--radius-card);
        background: var(--color-surface);
        backdrop-filter: blur(24px) saturate(140%);
        -webkit-backdrop-filter: blur(24px) saturate(140%);
        box-shadow: var(--shadow-deep), var(--shadow-inset);
        overflow: hidden;
        transform-style: preserve-3d;
        transition: transform 0.1s linear;
    }
    .gradient-border {
        position: absolute;
        inset: 0;
        border-radius: var(--radius-card);
        padding: 1px;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.16) 0%,
            rgba(255, 255, 255, 0.02) 100%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        z-index: 2;
    }
    .noise-overlay {
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
        opacity: 0.04;
        pointer-events: none;
        z-index: 1;
    }
    .spotlight {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            600px circle at var(--mx, 50%) var(--my, 50%),
            rgba(255, 255, 255, 0.06),
            transparent 40%
        );
        pointer-events: none;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .hero-card:hover .spotlight {
        opacity: 1;
    }
    .card-content {
        position: relative;
        z-index: 3;
        padding: var(--space-8);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #050505;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        position: relative;
    }
    /* Anillo degradé alrededor del logo */
    .avatar::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        padding: 1px;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.3) 0%,
            rgba(255, 255, 255, 0.05) 100%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        z-index: 1;
    }
    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        display: block;
    }

    .header-text {
        display: flex;
        flex-direction: column;
    }
    .name {
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.2;
        color: var(--color-text-primary);
    }
    .alias {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-chip);
        padding: var(--space-1) var(--space-3);
        font-size: 0.875rem;
        color: var(--color-text-primary);
        width: fit-content;
    }

    .pulsing-dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        animation: pulse 2s infinite;
    }
    @keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }

    .roles {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }
    .roles li {
        color: var(--color-text-secondary);
        font-size: 1rem;
        position: relative;
        padding-left: var(--space-4);
    }
    .roles li::before {
        content: "·";
        position: absolute;
        left: 0;
        color: var(--color-accent);
    }
    .location {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text-secondary);
        font-size: 0.9rem;
    }
    .stack-chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }
    .chip {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-secondary);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-chip);
    }
    .actions {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
    }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-box);
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        transition: all var(--duration-fast) var(--ease-out-expo);
    }
    .btn-primary {
        background: var(--color-text-primary);
        color: var(--color-bg);
    }
    .btn-primary:hover {
        background: #e4e4e7;
    }
    .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--color-text-primary);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }
    .socials {
        display: flex;
        gap: var(--space-4);
        color: var(--color-text-secondary);
    }
    .socials a {
        color: inherit;
        transition: color var(--duration-fast) ease;
    }
    .socials a:hover {
        color: var(--color-accent);
    }

    @media (max-width: 640px) {
        .card-content {
            padding: var(--space-6);
        }
        .name {
            font-size: 1.5rem;
        }
        .actions {
            flex-direction: column;
        }
        .btn {
            justify-content: center;
        }
    }
</style>

<script>
    const card = document.getElementById("hero-card");

    if (card) {
        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const isTouch = window.matchMedia("(hover: none)").matches;

        if (prefersReducedMotion || isTouch) {
            card.style.transform = "none";
        } else {
            let rafId;
            let mouseX = 0,
                mouseY = 0;
            let currentX = 0,
                currentY = 0;

            const handleMove = (e) => {
                const rect = card.getBoundingClientRect();
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
                card.style.setProperty("--mx", `${mouseX}px`);
                card.style.setProperty("--my", `${mouseY}px`);
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((mouseY - centerY) / centerY) * -4;
                const rotateY = ((mouseX - centerX) / centerX) * 4;
                cancelAnimationFrame(rafId);
                rafId = requestAnimationFrame(() => {
                    currentX += (rotateX - currentX) * 0.1;
                    currentY += (rotateY - currentY) * 0.1;
                    card.style.transform = `perspective(1000px) rotateX(${currentX}deg) rotateY(${currentY}deg)`;
                });
            };

            const handleLeave = () => {
                cancelAnimationFrame(rafId);
                card.style.transform =
                    "perspective(1000px) rotateX(0deg) rotateY(0deg)";
                currentX = 0;
                currentY = 0;
            };

            card.addEventListener("pointermove", handleMove);
            card.addEventListener("pointerleave", handleLeave);
        }
    }
</script>
