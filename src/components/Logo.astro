<svg
    width="56"
    height="56"
    viewBox="0 0 56 56"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="logo-svg"
>
    <!-- Fondo negro premium -->
    <rect width="56" height="56" fill="#050505" />

    <!-- Letra 'f' minúscula latina con gancho (serif elegante) -->
    <text
        x="28"
        y="39"
        font-family="ui-serif, Georgia, 'Times New Roman', Times, serif"
        font-size="38"
        font-weight="600"
        fill="#ffffff"
        text-anchor="middle"
        class="logo-f"
    >
        f
    </text>
</svg>

<style>
    .logo-svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .logo-f {
        /* Animación de brillo (glowing) suave y continua */
        animation: glow 2.5s ease-in-out infinite alternate;
    }

    @keyframes glow {
        0% {
            filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.3))
                drop-shadow(0 0 8px rgba(255, 255, 255, 0.1));
        }
        100% {
            filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.8))
                drop-shadow(0 0 16px rgba(255, 255, 255, 0.5))
                drop-shadow(0 0 24px rgba(255, 255, 255, 0.3));
        }
    }
</style>
